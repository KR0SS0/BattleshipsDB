@page "/"

<PageTitle>Battleship</PageTitle>

<h1>Battleship</h1>

<BoardGrid Board="testBoard" AreShipsVisible="true" />

@code {
    private readonly Board testBoard = CreateTestBoard();

    private static Board CreateTestBoard()
    {
        var board = new Board();
        board.TryPlaceShipsRandomly(Random.Shared);
        return board;
    }
}
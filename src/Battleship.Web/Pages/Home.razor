@page "/"

<PageTitle>Battleship</PageTitle>

<div class="game">
    <aside class="sidebar">
        <h1>Battleship</h1>

        <div class="controls">
            @if (isPlaying)
            {
                <button @onclick="StopGame">Stop game</button>
            }
            else
            {
                <select @bind="gameDifficulty">
                    @foreach (var difficulty in Enum.GetValues<Difficulty>())
                    {
                        <option value="@difficulty">@difficulty</option>
                    }
                </select>
                <button @onclick="StartNewGame">New game</button>
            }
        </div>

        <p class="message">@message</p>
    </aside>

    <section class="boards">
        <div class="board-panel">
            <h2>Enemy waters</h2>
            <BoardGrid Board="game.OpponentBoard" OnCellClick="PlayRoundAndFireAt" />
        </div>

        <div class="board-panel">
            <h2>Your fleet</h2>
            <BoardGrid Board="game.PlayerBoard" AreShipsVisible="true" />
        </div>
    </section>
</div>

@code {
    private string message = "Choose a difficulty and start a new game.";
    private Game game = new(); // Empty boards until the first game starts
    private Difficulty gameDifficulty = Game.DefaultDifficulty;
    private bool isPlaying;

    private void StartNewGame()
    {
        game = CreateGame(gameDifficulty);
        isPlaying = true;
        message = "Fire!";
    }

    private void StopGame()
    {
        isPlaying = false;
        message = "Game stopped.";
    }

    private static Game CreateGame(Difficulty difficulty)
    {
        var game = new Game(difficulty);

        game.PlayerBoard.TryPlaceShipsRandomly(Random.Shared); // TODO: Allow player to place ships manually
        game.OpponentBoard.TryPlaceShipsRandomly(Random.Shared);

        return game;
    }

    private void PlayRoundAndFireAt(Coordinate coordinate)
    {
        if (!isPlaying)
            return;

        var result = game.PlayRound(coordinate, Random.Shared);
        if (!result.IsSuccess)
        {
            message = result.Error.Message;
            return;
        }

        // Round results
        var round = result.Value;
        message = $"Fired at {round.PlayerShot.Coordinate}: {OutcomeMessage(round.PlayerShot)}.";
        if (round.OpponentShot is not null)
            message += $" Enemy fired back at {round.OpponentShot.Coordinate}: {OutcomeMessage(round.OpponentShot)}.";

        // Who won?
        if (game.Winner == Side.Player)
            message += " Enemy eliminated! Good job captain!";
        else if (game.Winner == Side.Opponent)
            message += " We will get them next time...";

        if (game.IsOver)
            isPlaying = false;
    }

    private static string OutcomeMessage(Shot shot) => shot.Outcome switch
    {
        ShotOutcome.Miss => "miss",
        ShotOutcome.Hit => "hit",
        ShotOutcome.Sunk => $"sunk the {shot.SunkShipType}",
        _ => throw new ArgumentOutOfRangeException(nameof(shot), shot.Outcome, null)
    };
}
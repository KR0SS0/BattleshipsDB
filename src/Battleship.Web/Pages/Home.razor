@page "/"
@inject SoundService Sound

<PageTitle>Battleship</PageTitle>

<div class="game">
    <aside class="sidebar">
        <h1>Battleship</h1>

        <div class="controls">
            @if (phase is GamePhase.PlacingShips or GamePhase.Playing)
            {
                <button class="button" @onclick="StopGame">Stop game</button>
            }
            else
            {
                <select @bind="gameDifficulty">
                    @foreach (var difficulty in Enum.GetValues<Difficulty>())
                    {
                        <option value="@difficulty">@difficulty</option>
                    }
                </select>
                <button class="button" @onclick="StartNewGame">New game</button>
            }
        </div>

        <p class="message">@message</p>
    </aside>

    <section class="boards">
        <div class="board-panel">
            <h2>Enemy waters</h2>
            <BoardGrid Board="game.OpponentBoard"
                       IsActive="phase == GamePhase.Playing"
                       AreShipsVisible="phase == GamePhase.Finished"
                       OnCellClick="PlayRoundAndFireAt" />
        </div>

        <div class="board-panel">
            <h2>Your fleet</h2>
            <BoardGrid Board="game.PlayerBoard"
                       IsActive="phase == GamePhase.PlacingShips"
                       AreShipsVisible="true"
                       PreviewShip="previewShip"
                       OnCellClick="PlaceNextShip"
                       OnCellRightClick="RotateAt"
                       OnCellHover="ShowPreview"
                       OnBoardLeave="ClearPreview" />
        </div>
    </section>

    <footer class="hints">
        @if (phase == GamePhase.PlacingShips)
        {
            <span class="hint"><MouseIcon /> Place ship</span>
            <span class="hint"><MouseIcon IsRightButton="true" /> Rotate ship</span>
        }
        else if (phase == GamePhase.Playing)
        {
            <span class="hint"><MouseIcon /> Fire at enemy board</span>
        }
    </footer>
</div>

@if (isGameOverVisible)
{
    <GameOverScreen Game="game" OnContinue="CloseGameOver" />
}

@code {
    private string message = "Choose a difficulty and start a new game.";
    private Game game = new(); // Empty boards until the first game starts
    private Difficulty gameDifficulty = Game.DefaultDifficulty;
    private GamePhase phase = GamePhase.NotStarted;

    // The enemy fires after a short random pause, so you can see its shot happen
    private const int EnemyDelayMinMs = 100;
    private const int EnemyDelayMaxMs = 250;
    private bool isEnemyAiming;

    // The end screen waits a moment, so the final explosion can be seen first
    private const int GameOverDelayMs = 900;
    private bool isGameOverVisible;

    // Ship placement
    private Orientation orientation = Orientation.Horizontal;
    private Coordinate? hoveredCell;
    private Ship? previewShip;

    private ShipType? NextShipType
    {
        get
        {
            var unplaced = game.PlayerBoard.UnplacedShipTypes();
            return unplaced.Count > 0 ? unplaced[0] : null;
        }
    }

    private void StartNewGame()
    {
        game = CreateGame(gameDifficulty);
        phase = GamePhase.PlacingShips;
        orientation = Orientation.Horizontal;
        isGameOverVisible = false;
        message = PlacementMessage();
    }

    private void CloseGameOver() => isGameOverVisible = false;

    private async Task FinishGameAsync()
    {
        phase = GamePhase.Finished;

        var finishedGame = game;
        await Task.Delay(GameOverDelayMs);
        if (game != finishedGame)
            return; // A new game was started during the pause

        isGameOverVisible = true;
        await Sound.PlayAsync(game.Winner == Side.Player ? GameSound.Victory : GameSound.Defeat);
    }

    private void StopGame()
    {
        phase = GamePhase.Finished;
        previewShip = null;
        message = "Game stopped.";
    }

    private static Game CreateGame(Difficulty difficulty)
    {
        var game = new Game(difficulty);
        game.OpponentBoard.TryPlaceShipsRandomly(Random.Shared);
        return game;
    }

    private async Task PlaceNextShip(Coordinate cell)
    {
        if (phase != GamePhase.PlacingShips || NextShipType is not ShipType type)
            return;

        var result = game.PlayerBoard.PlaceShip(new Ship(type, cell, orientation));
        if (!result.IsSuccess)
        {
            message = result.Error.Message;
            await Sound.PlayAsync(GameSound.Invalid);
            return;
        }

        // The last ship starts the battle
        if (game.PlayerBoard.AreAllShipsPlaced)
        {
            phase = GamePhase.Playing;
            previewShip = null;
            message = "Fleet ready. Fire at the enemy!";
        }
        else
        {
            message = PlacementMessage();
            UpdatePreview();
        }

        await Sound.PlayAsync(GameSound.Place);
    }

    private void RotateAt(Coordinate cell)
    {
        if (phase != GamePhase.PlacingShips)
            return;

        orientation = orientation == Orientation.Horizontal ? Orientation.Vertical : Orientation.Horizontal;
        hoveredCell = cell;
        UpdatePreview();
    }

    private void ShowPreview(Coordinate cell)
    {
        hoveredCell = cell;
        UpdatePreview();
    }

    private void ClearPreview()
    {
        hoveredCell = null;
        previewShip = null;
    }

    private void UpdatePreview()
    {
        previewShip = phase == GamePhase.PlacingShips && hoveredCell is Coordinate cell && NextShipType is ShipType type
            ? new Ship(type, cell, orientation)
            : null;
    }

    private string PlacementMessage() => NextShipType is ShipType type
        ? $"Place your {type}."
        : "All ships placed.";

    private async Task PlayRoundAndFireAt(Coordinate coordinate)
    {
        if (phase != GamePhase.Playing || isEnemyAiming)
            return;

        var playerShot = game.PlayerTurn(coordinate);
        if (!playerShot.IsSuccess)
        {
            message = playerShot.Error.Message;
            await Sound.PlayAsync(GameSound.Invalid);
            return;
        }

        // Ignore clicks until the enemy has fired back. Set before any await,
        // because every await lets Blazor handle other clicks in the meantime.
        isEnemyAiming = true;
        var gameBeforeDelay = game;

        message = $"Fired at {playerShot.Value.Coordinate}: {OutcomeMessage(playerShot.Value)}.";
        await Sound.PlayAsync(SoundFor(playerShot.Value));

        if (game.Winner == Side.Player)
        {
            isEnemyAiming = false;
            message += "\nEnemy eliminated! Good job captain!";
            await FinishGameAsync();
            return;
        }

        // Blazor redraws at each await, so the player's shot shows before the enemy fires
        await Task.Delay(Random.Shared.Next(EnemyDelayMinMs, EnemyDelayMaxMs + 1));
        isEnemyAiming = false;

        // The game may have been stopped or replaced during the delay
        if (game != gameBeforeDelay || phase != GamePhase.Playing)
            return;

        var opponentShot = game.OpponentTurn(Random.Shared);
        if (opponentShot is not null)
        {
            message += $"\nEnemy fired back at {opponentShot.Coordinate}: {OutcomeMessage(opponentShot)}.";
            await Sound.PlayAsync(SoundFor(opponentShot));
        }

        if (game.Winner == Side.Opponent)
        {
            message += "\nWe will get them next time...";
            await FinishGameAsync();
        }
    }

    private static GameSound SoundFor(Shot shot) => shot.Outcome switch
    {
        ShotOutcome.Miss => GameSound.Miss,
        ShotOutcome.Hit => GameSound.Hit,
        ShotOutcome.Sunk => GameSound.Sunk,
        _ => throw new ArgumentOutOfRangeException(nameof(shot), shot.Outcome, null)
    };

    private static string OutcomeMessage(Shot shot) => shot.Outcome switch
    {
        ShotOutcome.Miss => "miss",
        ShotOutcome.Hit => "hit",
        ShotOutcome.Sunk => $"sunk the {shot.SunkShipType}",
        _ => throw new ArgumentOutOfRangeException(nameof(shot), shot.Outcome, null)
    };
}

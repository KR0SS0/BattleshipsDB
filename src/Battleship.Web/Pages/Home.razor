@page "/"

<PageTitle>Battleship</PageTitle>

<div class="game">
    <aside class="sidebar">
        <h1>Battleship</h1>

        <div class="controls">
            @if (phase is GamePhase.PlacingShips or GamePhase.Playing)
            {
                <button @onclick="StopGame">Stop game</button>
            }
            else
            {
                <select @bind="gameDifficulty">
                    @foreach (var difficulty in Enum.GetValues<Difficulty>())
                    {
                        <option value="@difficulty">@difficulty</option>
                    }
                </select>
                <button @onclick="StartNewGame">New game</button>
            }
        </div>

        <p class="message">@message</p>
    </aside>

    <section class="boards">
        <div class="board-panel">
            <h2>Enemy waters</h2>
            <BoardGrid Board="game.OpponentBoard" OnCellClick="PlayRoundAndFireAt" />
        </div>

        <div class="board-panel">
            <h2>Your fleet</h2>
            <BoardGrid Board="game.PlayerBoard"
                       AreShipsVisible="true"
                       PreviewShip="previewShip"
                       OnCellClick="PlaceNextShip"
                       OnCellRightClick="RotateAt"
                       OnCellHover="ShowPreview"
                       OnBoardLeave="ClearPreview" />
        </div>
    </section>

    <footer class="hints">
        @if (phase == GamePhase.PlacingShips)
        {
            <span class="hint"><MouseIcon /> Place ship</span>
            <span class="hint"><MouseIcon IsRightButton="true" /> Rotate ship</span>
        }
        else if (phase == GamePhase.Playing)
        {
            <span class="hint"><MouseIcon /> Fire at enemy board</span>
        }
    </footer>
</div>

@code {
    private string message = "Choose a difficulty and start a new game.";
    private Game game = new(); // Empty boards until the first game starts
    private Difficulty gameDifficulty = Game.DefaultDifficulty;
    private GamePhase phase = GamePhase.NotStarted;

    // Ship placement
    private Orientation orientation = Orientation.Horizontal;
    private Coordinate? hoveredCell;
    private Ship? previewShip;

    private ShipType? NextShipType
    {
        get
        {
            var unplaced = game.PlayerBoard.UnplacedShipTypes();
            return unplaced.Count > 0 ? unplaced[0] : null;
        }
    }

    private void StartNewGame()
    {
        game = CreateGame(gameDifficulty);
        phase = GamePhase.PlacingShips;
        orientation = Orientation.Horizontal;
        message = PlacementMessage();
    }

    private void StopGame()
    {
        phase = GamePhase.Finished;
        previewShip = null;
        message = "Game stopped.";
    }

    private static Game CreateGame(Difficulty difficulty)
    {
        var game = new Game(difficulty);
        game.OpponentBoard.TryPlaceShipsRandomly(Random.Shared);
        return game;
    }

    private void PlaceNextShip(Coordinate cell)
    {
        if (phase != GamePhase.PlacingShips || NextShipType is not ShipType type)
            return;

        var result = game.PlayerBoard.PlaceShip(new Ship(type, cell, orientation));
        if (!result.IsSuccess)
        {
            message = result.Error.Message;
            return;
        }

        // The last ship starts the battle
        if (game.PlayerBoard.AreAllShipsPlaced)
        {
            phase = GamePhase.Playing;
            previewShip = null;
            message = "Fleet ready. Fire at the enemy!";
            return;
        }

        message = PlacementMessage();
        UpdatePreview();
    }

    private void RotateAt(Coordinate cell)
    {
        if (phase != GamePhase.PlacingShips)
            return;

        orientation = orientation == Orientation.Horizontal ? Orientation.Vertical : Orientation.Horizontal;
        hoveredCell = cell;
        UpdatePreview();
    }

    private void ShowPreview(Coordinate cell)
    {
        hoveredCell = cell;
        UpdatePreview();
    }

    private void ClearPreview()
    {
        hoveredCell = null;
        previewShip = null;
    }

    private void UpdatePreview()
    {
        previewShip = phase == GamePhase.PlacingShips && hoveredCell is Coordinate cell && NextShipType is ShipType type
            ? new Ship(type, cell, orientation)
            : null;
    }

    private string PlacementMessage() => NextShipType is ShipType type
        ? $"Place your {type}."
        : "All ships placed.";

    private void PlayRoundAndFireAt(Coordinate coordinate)
    {
        if (phase != GamePhase.Playing)
            return;

        var result = game.PlayRound(coordinate, Random.Shared);
        if (!result.IsSuccess)
        {
            message = result.Error.Message;
            return;
        }

        // Round results
        var round = result.Value;
        message = $"Fired at {round.PlayerShot.Coordinate}: {OutcomeMessage(round.PlayerShot)}.";
        if (round.OpponentShot is not null)
            message += $" Enemy fired back at {round.OpponentShot.Coordinate}: {OutcomeMessage(round.OpponentShot)}.";

        // Who won?
        if (game.Winner == Side.Player)
            message += " Enemy eliminated! Good job captain!";
        else if (game.Winner == Side.Opponent)
            message += " We will get them next time...";

        if (game.IsOver)
            phase = GamePhase.Finished;
    }

    private static string OutcomeMessage(Shot shot) => shot.Outcome switch
    {
        ShotOutcome.Miss => "miss",
        ShotOutcome.Hit => "hit",
        ShotOutcome.Sunk => $"sunk the {shot.SunkShipType}",
        _ => throw new ArgumentOutOfRangeException(nameof(shot), shot.Outcome, null)
    };
}

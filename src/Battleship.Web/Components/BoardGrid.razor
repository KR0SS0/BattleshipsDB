<table class="board @(IsActive ? "active" : "")" @onmouseleave="() => OnBoardLeave.InvokeAsync()">
    <thead>
        <tr>
            <th></th>
            @foreach (var column in Enumerable.Range(0, Board.Size))
            {
                <th>@((char)('A' + column))</th>
            }
        </tr>
    </thead>
    <tbody>
        @foreach (int row in Enumerable.Range(0, Board.Size))
        {
            <tr>
                <th>@(row + 1)</th>
                @foreach (int column in Enumerable.Range(0, Board.Size))
                {
                    var cell = new Coordinate(column, row);
                    <td class="@CellClass(cell) @(cell == lastShotCell ? "last-shot" : "")"
                        @onclick="() => OnCellClick.InvokeAsync(cell)"
                        @oncontextmenu="() => OnCellRightClick.InvokeAsync(cell)"
                        @oncontextmenu:preventDefault="OnCellRightClick.HasDelegate"
                        @onmouseover="() => OnCellHover.InvokeAsync(cell)"></td>
                }
            </tr>
        }
    </tbody>
</table>

@code {
    [Parameter, EditorRequired] public Board Board { get; set; } = default!;
    [Parameter] public bool AreShipsVisible { get; set; }
    [Parameter] public bool IsActive { get; set; }
    [Parameter] public Ship? PreviewShip { get; set; }
    [Parameter] public EventCallback<Coordinate> OnCellClick { get; set; }
    [Parameter] public EventCallback<Coordinate> OnCellRightClick { get; set; }
    [Parameter] public EventCallback<Coordinate> OnCellHover { get; set; }
    [Parameter] public EventCallback OnBoardLeave { get; set; }

    private HashSet<Coordinate> previewCells = [];
    private bool isPreviewValid;
    private Coordinate? lastShotCell;

    // Runs before each render: work these out once, instead of once per cell
    protected override void OnParametersSet()
    {
        previewCells = PreviewShip?.GetCells().ToHashSet() ?? [];
        isPreviewValid = PreviewShip is not null && Board.CheckPlacement(PreviewShip).IsSuccess;
        lastShotCell = Board.ShotHistory.Count > 0 ? Board.ShotHistory[^1].Coordinate : null;
    }

    private string CellClass(Coordinate coordinate)
    {
        var isCellShot = Board.ShotCells.Contains(coordinate);
        var ship = Board.ShipAtCoordinate(coordinate);

        if (ship is not null && Board.IsShipSunk(ship))
            return "sunk";
        if (isCellShot)
            return ship is null ? "miss" : "hit";
        if (previewCells.Contains(coordinate))
            return isPreviewValid ? "preview" : "preview-invalid";
        if (ship is not null && AreShipsVisible)
            return "ship";

        return "water";
    }
}
